# Server
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/edusphere
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# JWT (separate secrets for access vs refresh)
JWT_ACCESS_SECRET=replace_me_with_long_random_string
JWT_REFRESH_SECRET=replace_me_with_another_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# One-time tokens
EMAIL_VERIFICATION_TTL=24h

# Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Display-only login alias domain. Never used to send mail.
PUBLIC_DOMAIN=edusphere.app

# Nodemailer (transactional mail only — never to @PUBLIC_DOMAIN)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password_or_app_password
EMAIL_FROM="EduSphere Admin" no-reply@edusphere.app

# --- Cloudinary (required for assignment/material attachments) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
